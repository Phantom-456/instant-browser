{
  "name": "instant-browser",
  "version": "0.2.0",
  "private": true,
  "description": "Hotkey search bar that opens small floating one-tab browser windows.",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "pnpm build && playwright test",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.mac.yml --mac dir",
    "dist:win": "pnpm build && electron-builder --config electron-builder.win.yml --win dir",
    "dist:mac:release": "pnpm build && electron-builder --config electron-builder.mac.yml --mac --arm64 --x64 --publish never",
    "dist:win:release": "pnpm build && electron-builder --config electron-builder.win.yml --win --x64 --publish never"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "homepage": "https://phantom-456.github.io/instant-browser/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantom-456/instant-browser.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Instant Browser"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}

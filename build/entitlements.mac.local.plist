<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Local builds only (scripts/sign-local-mac.sh): a self-signed certificate has no Apple team ID, so the hardened
       runtime would refuse to load Electron's own framework. Release builds use entitlements.mac.plist without this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Chromium (Electron) needs these two to run its JavaScript engine under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Lets the app ask Dia to open a link in a chosen profile (it still asks the user first). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
